{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "live.agentfetch/agentfetch",
  "title": "AgentFetch API",
  "description": "Fetch public web pages live and get clean Markdown, text or HTML.",
  "version": "0.1.0",
  "websiteUrl": "https://agentfetch.live/docs/mcp",
  "icons": [
    {
      "src": "https://agentfetch.live/site-assets/agentfetch-live/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://agentfetch.live/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your AgentFetch API key as a bearer token: Bearer 1337_live_…",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
